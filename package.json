{
  "name": "graphinator",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Turn any concept into a graph you can explore.",
  "scripts": {
    "dev": "vite --port 3012",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --port 3012",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "html-to-image": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
